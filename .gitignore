.venv/
venv/
env/
runtime/

# Bundled large binaries & local AI models (>100 MB, exceed GitHub file limit)
bin/*.exe
models/

# Generated clips, temp downloads, logs & local SQLite history
clips/*.mp4
clips/*.jpg
clips/*.txt
